{
  "name": "app-abogado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "build:netlify": "node scripts/deploy-build.mjs",
    "build:deploy": "node scripts/deploy-build.mjs",
    "start:render": "next start -H 0.0.0.0 -p ${PORT:-10000}",
    "db:restore": "tsx --env-file-if-exists=.env scripts/restaurar-respaldo.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/crear-respaldo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@dojocoding/hacienda-sdk": "0.13.0",
    "bcryptjs": "^3.0.3",
    "dictionary-es": "4.0.0",
    "docxtemplater": "3.71.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "mammoth": "1.13.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "nspell": "2.1.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pizzip": "3.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "unpdf": "2.0.1",
    "word-extractor": "1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/nspell": "2.1.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
