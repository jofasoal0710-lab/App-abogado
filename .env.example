# Conexión a PostgreSQL
DATABASE_URL=postgres://abogado:abogado@localhost:5432/abogado

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Carpeta donde se guardan los documentos subidos (fuera de public/)
UPLOAD_DIR=./storage

# Datos fiscales / facturación
CURRENCY=CRC
DEFAULT_TAX_RATE=13
FIRM_NAME="Bufete Ejemplo & Asociados"
FIRM_TAX_ID=B00000000
FIRM_ADDRESS="Calle Mayor 1, 28001 Madrid"

# Zona horaria del despacho (agenda y fechas)
APP_TIMEZONE=America/Costa_Rica

# --- Recordatorios por correo (fase 1) ---
# Servidor SMTP (Gmail: smtp.gmail.com:465 + contraseña de aplicación; Outlook: smtp.office365.com:587)
SMTP_HOST=
SMTP_PORT=587
# true para puerto 465 (TLS directo); false para 587 (STARTTLS)
SMTP_SECURE=false
# Con SMTP_SECURE=false se EXIGE STARTTLS (si no hay cifrado, no se envía nada). Solo para un servidor
# interno de confianza sin TLS: SMTP_REQUIRE_TLS=false
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bufete Ejemplo <avisos@ejemplo.com>"
# URL pública de la app, para los enlaces de los correos
APP_URL=http://localhost:3000
# Antelaciones en días: 7,3,1,0 = una semana, 3 días, 1 día y el mismo día; -1 = aviso de vencido
REMINDER_DAYS=7,3,1,0,-1
# Hora local (0-23) a partir de la cual el planificador interno envía los avisos del día
REMINDER_HOUR=8
# true = planificador interno (una sola instancia). Alternativa: cron externo + CRON_SECRET
REMINDERS_SCHEDULER=false
CRON_SECRET=

# --- Despliegue en Netlify / serverless (ver DEPLOY.md) ---
# Número máximo de conexiones por instancia. En serverless usa un valor bajo (p. ej. 3) y una URL con pooler.
DATABASE_POOL_MAX=10
# Conexión DIRECTA (sin pooler) solo para aplicar migraciones en el build; si no se define, se usa DATABASE_URL.
MIGRATE_DATABASE_URL=
# Certificado (PEM) de la autoridad que firma el TLS de la base de datos, para proveedores con CA propia
# como Supabase. Con él la conexión es SIEMPRE cifrada y verificada (y se ignora sslmode de la URL).
# Admite saltos de línea reales o escritos como \n. Neon y la mayoría no lo necesitan.
DATABASE_SSL_CA=
# Primer administrador en el build de producción (solo si no hay ningún usuario). Bórralos tras el primer acceso.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Almacenamiento de documentos: local (disco, por defecto) o s3 (obligatorio en Netlify)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com · AWS S3: déjalo vacío
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true solo para MinIO/emuladores
S3_FORCE_PATH_STYLE=false

# --- Cabecera con la IP real del cliente (límite de intentos de login) ---
# Solo se confía en la cabecera que indiques aquí; si no, se usa X-Forwarded-For (falseable).
# Netlify: x-nf-client-connection-ip · Cloudflare delante: cf-connecting-ip · Render: ver DEPLOY-RENDER.md
CLIENT_IP_HEADER=

# --- Documentos en S3: mantenimiento (opcional) ---
# Minutos tras los que una subida preparada y nunca registrada se borra del bucket (60 por defecto).
ORPHAN_UPLOAD_MINUTES=
# Subidas que una persona puede preparar cada 15 minutos (100 por defecto).
UPLOAD_PREPARE_MAX=
# Intervalo mínimo entre ejecuciones del mantenimiento, en minutos (60 por defecto).
MAINTENANCE_INTERVAL_MINUTES=

# Retención de IRPF por defecto en facturas a empresas (15 = 15 %). 0 = no proponer retención.
# Es solo el valor inicial: se puede cambiar en cada borrador. Consúltalo con tu gestor.
DEFAULT_WITHHOLDING_RATE=0

# Factura electrónica (Hacienda). Solo en el servidor; nunca en el repositorio.
# HACIENDA_ENV=pruebas            # o produccion
# HACIENDA_USERNAME=cpj-...       # usuario del API (ATV / TRIBU-CR)
# HACIENDA_PASSWORD=
# HACIENDA_P12_BASE64=            # llave criptográfica .p12 en base64
# HACIENDA_P12_PIN=

# Cronómetro de horas: tramo de redondeo hacia arriba, en minutos (6 = décimas de hora).
# TIMER_ROUND_MINUTES=6

# --- Cloudflare Turnstile (verificación anti-robots en el login y en el formulario público) ---
# Créalas gratis en Cloudflare → Turnstile → «Add widget» (hostname: el dominio de la app). Sin ellas no se
# pide verificación. Claves de prueba (siempre pasan): sitio 1x00000000000000000000AA,
# secreto 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
