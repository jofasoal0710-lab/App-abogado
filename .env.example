# Conexión a PostgreSQL
DATABASE_URL=postgres://abogado:abogado@localhost:5432/abogado

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Carpeta donde se guardan los documentos subidos (fuera de public/)
UPLOAD_DIR=./storage

# Datos fiscales / facturación
CURRENCY=EUR
DEFAULT_TAX_RATE=21
FIRM_NAME="Bufete Ejemplo & Asociados"
FIRM_TAX_ID=B00000000
FIRM_ADDRESS="Calle Mayor 1, 28001 Madrid"

# Zona horaria del despacho (agenda y fechas)
APP_TIMEZONE=Europe/Madrid

# --- Recordatorios por correo (fase 1) ---
# Servidor SMTP (Gmail: smtp.gmail.com:465 + contraseña de aplicación; Outlook: smtp.office365.com:587)
SMTP_HOST=
SMTP_PORT=587
# true para puerto 465 (TLS directo); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bufete Ejemplo <avisos@ejemplo.com>"
# URL pública de la app, para los enlaces de los correos
APP_URL=http://localhost:3000
# Antelaciones en días: 7,3,1,0 = una semana, 3 días, 1 día y el mismo día; -1 = aviso de vencido
REMINDER_DAYS=7,3,1,0,-1
# Hora local (0-23) a partir de la cual el planificador interno envía los avisos del día
REMINDER_HOUR=8
# true = planificador interno (una sola instancia). Alternativa: cron externo + CRON_SECRET
REMINDERS_SCHEDULER=false
CRON_SECRET=
